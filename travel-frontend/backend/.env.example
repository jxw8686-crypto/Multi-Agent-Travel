# LLM API 配置（如果 ~/.openharness/settings.json 已配置则可不填）
# 或者用 OpenAI 兼容接口
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称（可选，默认读取 settings.json）
# OPENHARNESS_MODEL=claude-sonnet-4-6-20250922

# 服务端口
HOST=0.0.0.0
PORT=8000

# 项目根目录（.openharness 所在目录，默认自动检测）
# PROJECT_ROOT=D:\Python\PythonProject\OpenHarness-main\OpenHarness-main
